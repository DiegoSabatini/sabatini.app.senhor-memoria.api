# Banco de dados (docker compose up -d sobe um Postgres local com estes dados)
DATABASE_URL="postgresql://senhor:memoria@localhost:5432/senhor_memoria?schema=public"

# Autenticação
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=3000

# Agendador de doses (desligue em testes ou em instâncias extras)
SCHEDULER_ENABLED=true

# Notificações push via Expo (deixe false até o app estar publicado)
PUSH_ENABLED=false
